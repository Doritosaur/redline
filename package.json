{
  "name": "redline-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "vitest run",
    "redline": "node packages/cli/dist/index.js",
    "changeset": "changeset",
    "test:coverage": "vitest run --coverage",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
